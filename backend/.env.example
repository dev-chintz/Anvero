APP_NAME=Anvero API
APP_VERSION=0.1.0

ENVIRONMENT=development
DEBUG=true
# Logs every SQL statement. Values are never shown, since they include buyers'
# personal data and Allegro tokens; turn on only to see which queries run.
SQL_ECHO=false

HOST=127.0.0.1
PORT=8000

API_V1_PREFIX=/api/v1

# SQLite needs no setup, so a fresh clone runs straight away. A relative path
# is resolved against backend/, whichever directory a command is run from.
DATABASE_URL=sqlite:///./anvero.db
# PostgreSQL is the target database; docs/DEVELOPMENT.md has the setup.
# DATABASE_URL=postgresql+psycopg://anvero:YOUR_PASSWORD@localhost:5432/anvero
# Runs the test suite on PostgreSQL too. It must be a database of its own:
# the tests drop every table, and refuse to run against DATABASE_URL's.
# TEST_DATABASE_URL=postgresql+psycopg://anvero:YOUR_PASSWORD@localhost:5432/anvero_test

# Signs login tokens. Anyone who knows it can forge a login, so the API
# refuses to start without a random value of at least 32 characters.
# scripts\bootstrap.ps1 generates one per machine. .env is not committed.
SECRET_KEY=

# How long a login lasts. 480 = one working day.
ACCESS_TOKEN_EXPIRE_MINUTES=480

RATE_LIMIT_LOGIN=5/minute

# Calendar days in date filters are interpreted in this zone.
BUSINESS_TIMEZONE=Europe/Warsaw

# Allegro integration - leave empty to keep it switched off.
# Register an application at apps.developer.allegro.pl, fill in its id and
# secret, then run scripts\authorize_allegro.py once, which fills in the
# refresh token; see docs/INTEGRATIONS.md.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=
# Generated for the application on the developer portal ("User-Agent" tool)
# and pasted unchanged. Allegro blocks the application's key over calls
# without it, so nothing is sent to Allegro while this is empty.
ALLEGRO_USER_AGENT=
ALLEGRO_API_URL=https://api.allegro.pl
ALLEGRO_AUTH_URL=https://allegro.pl/auth/oauth
# Allegro Sandbox instead, for an application registered there:
# ALLEGRO_API_URL=https://api.allegro.pl.allegrosandbox.pl
# ALLEGRO_AUTH_URL=https://allegro.pl.allegrosandbox.pl/auth/oauth
# how far back the first import reaches; later ones fetch only what changed
ALLEGRO_INITIAL_IMPORT_DAYS=7
# minutes between imports the backend starts by itself; 0 = off. Enable on
# exactly ONE backend per database (Allegro rotates the refresh token on every use)
ALLEGRO_IMPORT_INTERVAL_MINUTES=0

# Erli integration - leave empty to keep it switched off.
# The API key comes from the Erli seller panel: My ERLI > Store settings >
# Integration method > Own API integration. See docs/INTEGRATIONS.md.
ERLI_API_KEY=
ERLI_API_URL=https://erli.pl/svc/shop-api
# how far back the first import reaches; later ones fetch only what changed
ERLI_INITIAL_IMPORT_DAYS=7
