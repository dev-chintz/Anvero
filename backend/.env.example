APP_NAME=Anvero API
APP_VERSION=0.1.0

ENVIRONMENT=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

API_V1_PREFIX=/api/v1

# SQLite needs no setup, so a fresh clone runs straight away. The path is
# relative to the directory commands are run from, which is backend/.
DATABASE_URL=sqlite:///./anvero.db
# PostgreSQL is the target database but its migration path has never been
# run; see docs/PROJECT_STATUS.md before switching to it.
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/anvero

SECRET_KEY=CHANGE_ME

RATE_LIMIT_LOGIN=5/minute

# Allegro integration - leave empty to keep it switched off.
# Obtain these by registering an application at apps.developer.allegro.pl and
# authorizing it once by hand; see docs/INTEGRATIONS.md.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REFRESH_TOKEN=
ALLEGRO_API_URL=https://api.allegro.pl
ALLEGRO_AUTH_URL=https://allegro.pl/auth/oauth